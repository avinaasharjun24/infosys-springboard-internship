# DEFECTIQ Environment Configuration Example
# Copy this file to .env and configure your secrets

# Database: PostgreSQL is the primary application database.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/defectiq
# Explicit lightweight local-development alternative only:
# DATABASE_URL=sqlite:///./defectiq.db

# Qdrant Vector Database (Embedded path on disk or remote server URL)
QDRANT_URL=
COLLECTION_NAME=eclipse_jdt_defects

# Embedding Model (Sentence Transformers - MiniLM 384 dims)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to true only when running offline with a pre-cached model
EMBEDDING_LOCAL_FILES_ONLY=false

# Google Gemini API
# Add your Gemini API key below to enable grounded LLM reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Historical Dataset Path (Eclipse JDT defect dataset)
DATASET_PATH=C:/Users/avina/Downloads/JDT/JDT_dataset_issues (1).csv

# Storage & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
